# ---- Clickfield OS environment ----
# Copy this file to .env.local and fill in values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_APP_NAME=Clickfield OS

# Server-only (NEVER expose to the browser). Used for admin tasks / seeding.
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
